# Elara infrastructure environment contract.
#
# Copy to `.env` and adjust locally: `cp .env.example .env`
# `.env` is gitignored (real secrets never leave the machine); `.env.example` is
# versioned on purpose (`!.env.example`) so the contract itself is reviewable.
#
# Every value below is a LOCAL-HOST dev default: it is what you use when you run
# the pieces directly on this machine (IDEs, scripts, published container ports).
# Keys annotated `container DNS in compose` point at a loopback address on purpose
# and MUST be overridden with the container service name by Etapa-03's
# `docker-compose.yml` — inside the container network `localhost` is the container
# itself, not the sibling service.

# --- Postgres (postgres/init-multiple-dbs.sh) ---------------------------------
# The official image creates POSTGRES_DB; the init script creates every database
# listed in POSTGRES_MULTIPLE_DATABASES if it is missing (idempotent).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_db
POSTGRES_MULTIPLE_DATABASES=inventory_db,unit_of_measure_db

# --- RabbitMQ (never the loopback-only `guest` user) --------------------------
# Read by the broker container itself (image variables), not by the services.
RABBITMQ_DEFAULT_USER=elara
RABBITMQ_DEFAULT_PASS=elara

# --- Vault --------------------------------------------------------------------
# Dev root token of the local `hashicorp/vault` dev server. Compose passes it to
# the server (VAULT_DEV_ROOT_TOKEN_ID) and derives both client tokens from it.
VAULT_DEV_ROOT_TOKEN_ID=00000000-0000-0000-0000-000000000000
# container DNS in compose: http://vault:8200
VAULT_ADDR=http://127.0.0.1:8200
# container DNS in compose: http://vault:8200
# Read by the services themselves (application-dev.yml `uri: ${VAULT_URI:...}`),
# so this is the URI the services use to reach Vault, including inside compose.
VAULT_URI=http://127.0.0.1:8200

# DOUBLE MAPPING (I-06): the application YAML declares
# `token: ${VAULT_TOKEN:00000000-0000-0000-0000-000000000000}` (ETAPA-01/C-10),
# while Spring Boot's native relaxed binding for `spring.cloud.vault.token` reads
# SPRING_CLOUD_VAULT_TOKEN. Compose feeds BOTH from the dev root token, so the
# YAML placeholder and the compose wiring can never drift into a 403.
VAULT_TOKEN=${VAULT_DEV_ROOT_TOKEN_ID}
SPRING_CLOUD_VAULT_TOKEN=${VAULT_DEV_ROOT_TOKEN_ID}

# --- Config server ------------------------------------------------------------
# Same value locally and in compose (it is a public URL, not a service address).
CONFIG_GIT_URI=https://github.com/elara-app/centralized-configuration.git
# Branch the Config Server clones; matches `default-label: main` in the app.
CONFIG_GIT_DEFAULT_LABEL=main
# container DNS in compose: http://config-service:8888
CONFIG_URI=http://localhost:8888

# --- Eureka -------------------------------------------------------------------
# container DNS in compose: http://discovery-service:8761/eureka/
EUREKA_URI=http://localhost:8761/eureka/

# --- Ports --------------------------------------------------------------------
# Compose sets each service's SERVER_PORT from these; the services themselves
# only read SERVER_PORT (server.port in the config repo defaults to it).
SERVER_PORT_CONFIG=8888
SERVER_PORT_DISCOVERY=8761
SERVER_PORT_GATEWAY=8080
SERVER_PORT_INVENTORY=8081
SERVER_PORT_UOM=8082

# --- Service overrides --------------------------------------------------------
# Values the services read as Spring properties (see centralized-configuration
# *-dev.yml). Compose injects them per container.
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# container DNS in compose: rabbitmq
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=elara
SPRING_RABBITMQ_PASSWORD=elara

# Compose sets SPRING_DATASOURCE_URL per service container (the datasource lives
# inside the compose network, so it is not a host value):
#   inventory-service:     jdbc:postgresql://postgres-inventory:5432/inventory_db
#   unit-of-measure-service: jdbc:postgresql://postgres-uom:5432/unit_of_measure_db
